# Feito de Nós — Variáveis de ambiente para produção

# Supabase público (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-ou-publishable

# Supabase servidor (obrigatório e SECRETO — nunca usar NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Salt longo e aleatório para anonimizar IPs do rate limit público
# Exemplo de geração: openssl rand -hex 32
RATE_LIMIT_SALT=troque-por-um-valor-aleatorio-longo

# WhatsApp oficial para recebimento/continuidade dos pedidos
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# URL pública canônica do projeto (recomendado para produção)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
